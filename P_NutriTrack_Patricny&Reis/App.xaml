<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:P_NutriTrack_Patricny_Reis"
             x:Class="P_NutriTrack_Patricny_Reis.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- couleurs choisie pour notre app -->
            <Color x:Key="CouleurFond">#7A8FA3</Color>
            <Color x:Key="CouleurCarte">#DEE9F0</Color>
            <Color x:Key="CouleurBouton">#DEE9F0</Color>
            <Color x:Key="CouleurTexte">#1F2A37</Color>
            <Color x:Key="CouleurTexteClair">#FFFFFF</Color>
            <Color x:Key="CouleurTexteSecondaire">#3D4A5C</Color>
            <Color x:Key="CouleurDanger">#B85450</Color>

            <!-- style des page de l app -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource CouleurFond}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
