<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:P_NutriTrack_Patricny_Reis"
             x:Class="P_NutriTrack_Patricny_Reis.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- coulaurs generales-->
            <Color x:Key="CouleurFond">#7A8DA3</Color>
            <Color x:Key="CouleurCarte">#CFE0F0</Color>
            <Color x:Key="CouleurBouton">#5A6B80</Color>
            <Color x:Key="CouleurTexte">#1F2A37</Color>
            <Color x:Key="CouleurTexteClair">#FFFFFF</Color>
            
            <!-- style des page de l app -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource CouleurFond}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
