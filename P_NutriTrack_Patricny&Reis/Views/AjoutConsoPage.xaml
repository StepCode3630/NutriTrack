<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_NutriTrack_Patricny_Reis.Views.AjoutConsoPage"
             Title="NutriTrack"
             BackgroundColor="{StaticResource CouleurFond}">

    <!-- logo dans le header -->
    <Shell.TitleView>
        <Image Source="logo_nutri_track.png"
           HeightRequest="35"
           Aspect="AspectFit"
           HorizontalOptions="Start"
           VerticalOptions="Center"/>
    </Shell.TitleView>


    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="home.svg"
                     Clicked="OnHomeClicked"
                     Order="Primary"
                     Priority="0" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto"
          Padding="20" RowSpacing="15">

        <Label Grid.Row="0"
               Text="Quantité consommée"
               FontSize="18" FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,15,0,0"/>

        <Label Grid.Row="1"
               x:Name="NomAlimentLabel"
               FontSize="24" FontAttributes="Bold"
               TextColor="{StaticResource CouleurTexte}"
               HorizontalOptions="Center"
               Margin="0,15,0,15"/>

        <!-- pour saisir la quantité -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Label Grid.Column="0" Text="Quantité" FontSize="14"
                   TextColor="{StaticResource CouleurTexte}"
                   VerticalOptions="Center"/>
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CouleurCarte}"
                    StrokeShape="RoundRectangle 15"
                    Stroke="Transparent" Padding="10,0">
                <Entry x:Name="QuantiteEntry"
                       Placeholder="Ex. 100"
                       Keyboard="Numeric"
                       TextColor="{StaticResource CouleurTexte}"
                       BackgroundColor="Transparent"
                       TextChanged="OnQuantiteChanged"/>
            </Border>
            <Label Grid.Column="2" Text="g" FontSize="14"
                   TextColor="{StaticResource CouleurTexte}"
                   VerticalOptions="Center"/>
        </Grid>

        <Label Grid.Row="3"
               Text="Pour : (calculé par rapport à la quantité)"
               FontSize="11"
               TextColor="{StaticResource CouleurTexteSecondaire}"
               HorizontalOptions="Center"
               Margin="0,15,0,0"/>

        <!-- calculs -->
        <VerticalStackLayout Grid.Row="4" Spacing="8" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="calories" FontSize="14"
                       TextColor="{StaticResource CouleurTexte}"/>
                <Label Grid.Column="1" x:Name="CalCalcLabel" Text="0"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource CouleurTexte}"/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="protéines (g)" FontSize="14"
                       TextColor="{StaticResource CouleurTexte}"/>
                <Label Grid.Column="1" x:Name="ProtCalcLabel" Text="0"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource CouleurTexte}"/>
            </Grid>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Label Grid.Column="0" Text="glucides (g)" FontSize="14"
                       TextColor="{StaticResource CouleurTexte}"/>
                <Label Grid.Column="1" x:Name="GlucCalcLabel" Text="0"
                       FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource CouleurTexte}"/>
            </Grid>
        </VerticalStackLayout>

        <Button Grid.Row="5"
                Text="Ajouter à ma journée"
                BackgroundColor="{StaticResource CouleurCarte}"
                TextColor="{StaticResource CouleurTexte}"
                FontSize="14" FontAttributes="Bold"
                CornerRadius="20" HeightRequest="48"
                Clicked="OnAjouterClicked"/>

        <Button Grid.Row="6"
                Text="Annuler"
                BackgroundColor="Transparent"
                TextColor="{StaticResource CouleurTexteSecondaire}"
                FontSize="13"
                Clicked="OnAnnulerClicked"/>
    </Grid>
</ContentPage>