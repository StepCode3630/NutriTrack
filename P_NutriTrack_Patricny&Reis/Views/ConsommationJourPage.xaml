<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_NutriTrack_Patricny_Reis.Views.ConsommationJourPage"
             Title="NutriTrack"
             BackgroundColor="{StaticResource CouleurFond}">

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Padding="20" RowSpacing="12">

        <!-- titre -->
        <Label Grid.Row="0"
               Text="Aujourd'hui"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,15,0,0"/>

        <!-- la date du jour-->
        <Label Grid.Row="1"
               x:Name="DateLabel"
               FontSize="14"
               TextColor="{StaticResource CouleurTexteSecondaire}"
               HorizontalOptions="Center"/>

        <!-- 4 cartes pour stats conso du jour -->
        <Grid Grid.Row="2" RowDefinitions="*,*" ColumnDefinitions="*,*"
              RowSpacing="10" ColumnSpacing="10" Margin="0,10,0,0">

            <Border Grid.Row="0" Grid.Column="0"
                    BackgroundColor="{StaticResource CouleurCarte}"
                    StrokeShape="RoundRectangle 15"
                    Stroke="Transparent" Padding="10" HeightRequest="70">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="TotalCaloriesLabel" Text="0"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource CouleurTexte}"
                           HorizontalOptions="Center"/>
                    <Label Text="Kcal" FontSize="11"
                           TextColor="{StaticResource CouleurTexteSecondaire}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    BackgroundColor="{StaticResource CouleurCarte}"
                    StrokeShape="RoundRectangle 15"
                    Stroke="Transparent" Padding="10" HeightRequest="70">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="TotalProteinesLabel" Text="0"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource CouleurTexte}"
                           HorizontalOptions="Center"/>
                    <Label Text="g protéines" FontSize="11"
                           TextColor="{StaticResource CouleurTexteSecondaire}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="0"
                    BackgroundColor="{StaticResource CouleurCarte}"
                    StrokeShape="RoundRectangle 15"
                    Stroke="Transparent" Padding="10" HeightRequest="70">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="TotalGlucidesLabel" Text="0"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource CouleurTexte}"
                           HorizontalOptions="Center"/>
                    <Label Text="g glucides" FontSize="11"
                           TextColor="{StaticResource CouleurTexteSecondaire}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="1"
                    BackgroundColor="{StaticResource CouleurCarte}"
                    StrokeShape="RoundRectangle 15"
                    Stroke="Transparent" Padding="10" HeightRequest="70">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label x:Name="TotalLipidesLabel" Text="0"
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource CouleurTexte}"
                           HorizontalOptions="Center"/>
                    <Label Text="g lipides" FontSize="11"
                           TextColor="{StaticResource CouleurTexteSecondaire}"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Liste conso du jour -->
        <CollectionView Grid.Row="3"
                        x:Name="ConsoListView"
                        Margin="0,15,0,0"
                        EmptyView="Aucun aliment consommé aujourd'hui">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource CouleurCarte}"
                            StrokeShape="RoundRectangle 15"
                            Stroke="Transparent"
                            Margin="0,4" Padding="12">
                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                <Label Text="{Binding NomAliment}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource CouleurTexte}"/>
                                <Label Text="{Binding InfoLigne}"
                                       FontSize="11"
                                       TextColor="{StaticResource CouleurTexteSecondaire}"/>
                            </VerticalStackLayout>

                            <Button Grid.Column="1" Text="✏" FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource CouleurTexte}"
                                    Clicked="OnEditClicked"
                                    CommandParameter="{Binding ConsommationId}"
                                    WidthRequest="35" HeightRequest="35" Padding="0"/>

                            <Button Grid.Column="2" Text="🗑" FontSize="14"
                                    BackgroundColor="Transparent"
                                    TextColor="{StaticResource CouleurTexte}"
                                    Clicked="OnDeleteClicked"
                                    CommandParameter="{Binding ConsommationId}"
                                    WidthRequest="35" HeightRequest="35" Padding="0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- btn ajouter -->
        <Button Grid.Row="4"
                Text="+ Ajouter un aliment"
                BackgroundColor="{StaticResource CouleurCarte}"
                TextColor="{StaticResource CouleurTexte}"
                FontSize="14" FontAttributes="Bold"
                CornerRadius="20" HeightRequest="48"
                Clicked="OnAddClicked"/>
    </Grid>
</ContentPage>