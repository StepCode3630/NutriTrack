<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="P_NutriTrack_Patricny_Reis.Views.SelectionAlimentPage"
             Title="NutriTrack"
             BackgroundColor="{StaticResource CouleurFond}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="20" RowSpacing="12">

        <Label Grid.Row="0"
               Text="Choisir un aliment"
               FontSize="20" FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,15,0,0"/>

        <!-- champ recherche -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource CouleurCarte}"
                StrokeShape="RoundRectangle 20"
                Stroke="Transparent" Padding="15,5">
            <Entry x:Name="RechercheEntry"
                   Placeholder="Rechercher..."
                   PlaceholderColor="{StaticResource CouleurTexteSecondaire}"
                   TextColor="{StaticResource CouleurTexte}"
                   BackgroundColor="Transparent"
                   TextChanged="OnRechercheChanged"/>
        </Border>

        <!-- liste avec filtre-->
        <CollectionView Grid.Row="2"
                        x:Name="AlimentListView"
                        SelectionMode="Single"
                        SelectionChanged="OnAlimentSelected"
                        EmptyView="Aucun aliment trouvé">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{StaticResource CouleurCarte}"
                            StrokeShape="RoundRectangle 20"
                            Stroke="Transparent"
                            Margin="0,4" Padding="15,10">
                        <Label Text="{Binding Name}"
                               FontSize="14"
                               TextColor="{StaticResource CouleurTexte}"
                               HorizontalOptions="Center"/>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>